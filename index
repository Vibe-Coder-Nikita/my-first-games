<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Наш Классный Уголок</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Montserrat', Arial, sans-serif; 
            background-color: #1e1e1e; 
            color: #d4d4d4; 
            text-align: center;
            padding: 20px;
            margin: 0;
            transition: background-color 0.5s; 
        }
        
        .header {
            background-color: #0056b3; 
            color: white;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 30px;
            box-shadow: 0 4px 15px rgba(0, 86, 179, 0.4); 
        }
        
        .countdown-container {
            background: #252526;
            border-radius: 15px;
            padding: 20px;
            max-width: 600px;
            margin: 0 auto 40px auto;
            box-shadow: 0 4px 10px rgba(0,0,0,0.5);
            border: 2px solid #4db8ff; 
        }
        
        .countdown-title {
            color: #4db8ff;
            font-size: 20px;
            margin-bottom: 15px;
            font-weight: bold;
        }
        
        .countdown-timer {
            display: flex;
            justify-content: center;
            gap: 15px;
        }
        
        .time-block {
            background: #1e1e1e;
            padding: 15px;
            border-radius: 10px;
            min-width: 70px;
            box-shadow: inset 0 0 10px rgba(0,0,0,0.8);
        }
        
        .time-block span {
            display: block;
            font-size: 30px;
            font-weight: bold;
            color: #00ff00; 
            text-shadow: 0 0 10px rgba(0, 255, 0, 0.5);
        }
        
        .time-block p {
            margin: 5px 0 0 0;
            font-size: 12px;
            color: #888;
            text-transform: uppercase;
        }
        
        .container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
            margin-top: 20px;
            margin-bottom: 40px;
        }
        
        .card {
            background: #252526; 
            border-radius: 15px;
            padding: 20px;
            width: 200px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.5);
            transition: transform 0.2s, border 0.2s;
            border: 2px solid transparent;
        }
        
        .card:hover {
            transform: scale(1.05); 
            border: 2px solid #4db8ff; 
        }
        
        img {
            border-radius: 50%; 
            object-fit: cover;
            margin-bottom: 10px;
            border: 3px solid #4db8ff; 
            background-color: #fff;
        }
        
        h2 { color: #ffffff; margin-bottom: 10px; margin-top: 30px;}
        p { color: #a0a0a0; margin: 5px 0; font-size: 15px;}
        h3 { color: #4db8ff; margin-bottom: 10px; font-size: 18px;}
        
        .info-box {
            background: #252526;
            border-radius: 15px;
            padding: 20px;
            max-width: 600px;
            margin: 0 auto 30px auto;
            box-shadow: 0 4px 10px rgba(0,0,0,0.5);
            text-align: left; 
        }
        
        .info-box p {
            font-size: 18px;
            color: #d4d4d4;
            margin: 10px 0;
            border-bottom: 1px solid #333; 
            padding-bottom: 5px;
        }
        
        .info-box h3 {
            color: #4db8ff;
            margin-top: 25px;
            margin-bottom: 10px;
            border-bottom: 2px solid #0056b3;
            padding-bottom: 5px;
            text-align: left;
        }

        footer {
            margin-top: 60px;
            padding: 20px;
            color: #666;
            font-size: 14px;
            border-top: 1px solid #333;
            font-weight: 700;
            cursor: pointer; 
            user-select: none; 
        }

        /* СТИЛИ ДЛЯ ПАСХАЛКИ */
        #meme-popup {
            display: none; 
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.9);
            z-index: 1000;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            backdrop-filter: blur(5px); 
        }

        #meme-popup img {
            max-width: 80%;
            max-height: 70%;
            border-radius: 20px;
            border: 5px solid #00ff00;
            box-shadow: 0 0 30px #00ff00;
            object-fit: contain; 
        }

        .close-btn {
            margin-top: 20px;
            padding: 10px 30px;
            background: #0056b3;
            color: white;
            border: none;
            border-radius: 5px;
            font-size: 18px;
            cursor: pointer;
            font-family: 'Montserrat', sans-serif;
            font-weight: bold;
        }

        .close-btn:hover {
            background: #4db8ff;
            color: #000;
        }
    </style>
</head>
<body>

    <div class="header">
        <h1>Наш Класс</h1>
        <h2>6 класс</h2>
    </div>

    <div class="countdown-container">
        <div class="countdown-title">До летних каникул осталось:</div>
        <div class="countdown-timer">
            <div class="time-block"><span id="days">0</span><p>Дней</p></div>
            <div class="time-block"><span id="hours">0</span><p>Часов</p></div>
            <div class="time-block"><span id="minutes">0</span><p>Минут</p></div>
            <div class="time-block"><span id="seconds">0</span><p>Секунд</p></div>
        </div>
    </div>

    <h2>Наш классный руководитель</h2>
    <div class="container">
        <div class="card">
            <img src="https://cdn-icons-png.flaticon.com/512/1995/1995574.png" width="120" height="120" alt="Учитель">
            <h3>Булатова Юлия Александровна</h3>
            <p>Классный руководитель</p>
        </div>
    </div>

    <h2>Наш дружный коллектив</h2>
    <div class="container">
        
        <div class="card">
            <img src="https://ui-avatars.com/api/?name=Никита&background=0056b3&color=fff&size=128" width="100" height="100" alt="Никита">
            <h3>Непомнящих Никита</h3>
            <p>Главный по мемам</p>
        </div>

        <div class="card">
            <img src="https://ui-avatars.com/api/?name=Тигран&background=0056b3&color=fff&size=128" width="100" height="100" alt="Тигран">
            <h3>Пищиков Тигран</h3>
            <p>Лучший помощник</p>
        </div>

        <div class="card">
            <img src="https://ui-avatars.com/api/?name=Арсений&background=0056b3&color=fff&size=128" width="100" height="100" alt="Арсений">
            <h3>Горбацевич Арсений</h3>
            <p>Мастер спорта</p>
        </div>

        <div class="card">
            <img src="https://ui-avatars.com/api/?name=Илья&background=0056b3&color=fff&size=128" width="100" height="100" alt="Илья">
            <h3>Дубровин Илья</h3>
            <p>Легенда школы</p>
        </div>

    </div>

    <h2>Расписание звонков</h2>
    <div class="info-box">
        <p><b>1 урок:</b> 08:30 - 09:10</p>
        <p><b>2 урок:</b> 09:20 - 10:00</p>
        <p><b>3 урок:</b> 10:15 - 10:55</p>
        <p><b>4 урок:</b> 11:10 - 11:50</p>
        <p><b>5 урок:</b> 12:00 - 12:40</p>
    </div>

    <h2>Расписание уроков</h2>
    <div class="info-box">
        <h3>Понедельник</h3>
        <p>1. Разговоры о важном</p>
        <p>2. Русский язык</p>
        <p>3. Математика</p>
        <p>4. Физра</p>
        <p>5. Литература</p>
        <p>6. ИЗО</p>

        <h3>Вторник</h3>
        <p>1. Математика</p>
        <p>2. Русский язык</p>
        <p>3. Английский</p>
        <p>4. История</p>
        <p>5. Математика</p>
        <p>6. Русский</p>

        <h3>Среда</h3>
        <p>1. Математика</p>
        <p>2. Русский</p>
        <p>3. Литература</p>
        <p>4. Биология</p>
        <p>5. Физра</p>
        <p>6. История</p>

        <h3>Четверг</h3>
        <p>1. Математика</p>
        <p>2. Русский</p>
        <p>3. Физра</p>
        <p>4. География</p>
        <p>5. Английский</p>
        <p>6-7. Труд</p>
        <p>8. Россия - мои горизонты</p>

        <h3>Пятница</h3>
        <p>1. Русский</p>
        <p>2. Математика</p>
        <p>3. Английский</p>
        <p>4. История</p>
        <p>5. Шахматы</p>
        <p>6. Литература</p>
    </div>

    <h2>График дежурства</h2>
    <div class="info-box">
        <p><b>Понедельник:</b> Непомнящих Никита</p>
        <p><b>Вторник:</b> Пищиков Тигран</p>
        <p><b>Среда:</b> Горбацевич Арсений</p>
        <p><b>Четверг:</b> Дубровин Илья</p>
        <p><b>Пятница:</b> Всем классом! 🎉</p>
    </div>

    <footer id="secret-trigger">
        Сайт сделал Никита (VibeCoder) с помощью HTML, CSS и нейросети 🚀
    </footer>

    <div id="meme-popup">
        <img src="meme.jpg" alt="Секретный мем">
        <p style="color: white; margin-top: 20px; font-size: 24px; text-shadow: 0 0 10px #00ff00;">Ты нашел секрет! 🥚</p>
        <button class="close-btn" onclick="document.getElementById('meme-popup').style.display='none'">Закрыть</button>
    </div>

    <script>
        // 1. ТАЙМЕР
        const countDownDate = new Date("Jun 1, 2027 00:00:00").getTime();
        const timer = setInterval(function() {
            const now = new Date().getTime();
            const distance = countDownDate - now;
            const days = Math.floor(distance / (1000 * 60 * 60 * 24));
            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((distance % (1000 * 60)) / 1000);

            document.getElementById("days").innerText = days;
            document.getElementById("hours").innerText = hours;
            document.getElementById("minutes").innerText = minutes;
            document.getElementById("seconds").innerText = seconds;

            if (distance < 0) {
                clearInterval(timer);
                document.querySelector(".countdown-title").innerHTML = "УРА! КАНИКУЛЫ! 🎉";
                document.getElementById("days").innerText = "0";
                document.getElementById("hours").innerText = "0";
                document.getElementById("minutes").innerText = "0";
                document.getElementById("seconds").innerText = "0";
            }
        }, 1000);

        // 2. ПАСХАЛКА (5 КЛИКОВ)
        let clickCount = 0;
        const trigger = document.getElementById("secret-trigger");
        trigger.addEventListener("click", function() {
            clickCount++; 
            if (clickCount === 5) {
                document.body.style.backgroundColor = "#ff69b4"; 
                document.getElementById("meme-popup").style.display = "flex"; 
                clickCount = 0; 
            }
        });
    </script>

</body>
</html>
